# --- GHCR (GitHub Container Registry) ---
# GitHub username yoki org nomi (kichik harf).
GHCR_OWNER=your-github-login
IMAGE_TAG=latest

# --- Domenlar (DNS A yozuvlari Vultr IP ga qarab sozlangan bo‘lishi kerak) ---
APP_DOMAIN=erp.example.com
API_DOMAIN=api.example.com

# --- Postgres ---
POSTGRES_USER=furniture
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=furniture_erp

# Konteynerlar ichidagi ulanish (host nomi: postgres)
DATABASE_URL=postgresql://furniture:change-me-strong-password@postgres:5432/furniture_erp?schema=public

# --- API ---
JWT_ACCESS_SECRET=change-me-at-least-32-chars-openssl-rand-base64-48
JWT_ACCESS_EXPIRES=900s
JWT_REFRESH_EXPIRES_DAYS=7

# Frontend manzili (CORS)
CORS_ORIGIN=https://erp.example.com

# Brauzer uchun yuklangan rasmlar bazaviy URL (odatda API domeni)
PUBLIC_UPLOAD_BASE_URL=https://api.example.com

# --- Web (SSR ichki chaqiriqlar; brauzer API ga /api/proxy orqali boradi) ---
AUTH_INTERNAL_ORIGIN=https://erp.example.com
NEXT_PUBLIC_APP_URL=https://erp.example.com

# Ixtiyoriy: klientda bevosita API URL kerak bo‘lsa (aks holda CI/build da ham berish mumkin)
# NEXT_PUBLIC_API_URL=https://api.example.com




