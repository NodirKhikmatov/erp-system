# --- GHCR (GitHub Container Registry) ---
# GitHub username yoki org nomi (kichik harf).
GHCR_OWNER=your-github-login
IMAGE_TAG=latest

# --- Nginx allaqachon 80/443 da bo‘lsa (boshqa loyiha) ---
# Default portlar boshqa stack bilan to‘qnashmasligi uchun yuqori:
WEB_PUBLISH_PORT=13080
API_PUBLISH_PORT=14080
# .env da o‘zgartirsangiz, nginx upstream larni ham xuddi shu portlarga moslang.

# --- Domen (bitta; DNS A yozuvlari VPS IP ga) ---
APP_DOMAIN=petpawfectly.shop
# Eski Caddy ikki-host rejimi olib tashlandi — faqat APP_DOMAIN ishlatiladi.

# --- FAQAT VPS IP orqali vaqtincha (HTTPS yo‘q) ---
# localhost / 127.0.0.1 yozmang:
# NEXT_PUBLIC_APP_URL=http://YOUR_VPS_IP
# AUTH_INTERNAL_ORIGIN=http://YOUR_VPS_IP
# CORS_ORIGIN=http://YOUR_VPS_IP

# --- Postgres ---
POSTGRES_USER=furniture
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=furniture_erp

# Konteynerlar ichidagi ulanish (host nomi: postgres)
DATABASE_URL=postgresql://furniture:change-me-strong-password@postgres:5432/furniture_erp?schema=public

# --- API ---
JWT_ACCESS_SECRET=change-me-at-least-32-chars-openssl-rand-base64-48
JWT_ACCESS_EXPIRES=900s
JWT_REFRESH_EXPIRES_DAYS=7

# Frontend manzili (CORS) — oxirida / qo‘ymang
CORS_ORIGIN=https://petpawfectly.shop

# Yuklangan fayllar — nginx /uploads/ ni API ga proxylaydi (bitta domen)
PUBLIC_UPLOAD_BASE_URL=https://petpawfectly.shop

# --- Web (SSR; brauzer API ga /api/proxy orqali boradi) ---
# GitHub Actions Secrets: NEXT_PUBLIC_APP_URL (va kerak bo‘lsa NEXT_PUBLIC_API_URL) shu qiymatlarga mos bo‘lsin (build vaqti).
AUTH_INTERNAL_ORIGIN=https://petpawfectly.shop
NEXT_PUBLIC_APP_URL=https://petpawfectly.shop

# Klient API ga odatda /api/proxy orqali boradi; alohida API_URL kerak emas
