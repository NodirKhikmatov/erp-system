NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://furniture:furniture@localhost:5433/furniture_erp?schema=public"
# JWT (kirish jetonlari). Ishlab chiqarishda kuchli sir — masalan: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-to-at-least-32-characters-long-secret"
JWT_ACCESS_EXPIRES=900s
JWT_REFRESH_EXPIRES_DAYS=7

# Rasmlarni mahalliy diskka yozish (`POST /uploads/image`)
# Bo‘lmaganda: Turboreppo ildizidan ishga `.../apps/api/.local/upload-images`; faqat api papkasidan ─ `.local/upload-images`
# LOCAL_IMAGE_UPLOAD_DIR=.local/upload-images
# Brauzer/DB uchun to‘liq URL prefiksi (prod: HTTPS API); bo‘lmasa default http://localhost:PORT
# PUBLIC_UPLOAD_BASE_URL=http://localhost:4000
# UPLOAD_MAX_IMAGE_BYTES=5242880

# Telegram (Telegraf, webhook — ixtiyoriy)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# HTTPS domen + Nest marshruti: .../integrations/telegram/webhook
# TELEGRAM_WEBHOOK_BASE_URL=https://api.sizning-domen.uz
# setWebhook secret_token va tekshiruv (kamida 8 belgi, tasodifiy)
# TELEGRAM_WEBHOOK_SECRET=your-long-random-secret
# Mahallida webhook kerak boʻlmasligi mumkin:
# TOKEN bor, HTTPS URL yo‘q bo‘lsa, NODE_ENV=development ichida polling avtomatik yoqiladi.
# Yoki toʻliq webhook qoldirmasdan majburan polling: NODE_ENV=development + quyidagi qator
# TELEGRAM_DEV_POLLING=true

# Puppeteer PDF: `puppeteer-core` — tizimda Chrome/Chromium yo‘li (majburiy, PDF uchun)
# macOS Google Chrome:
# PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Linux (masalan):
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Brauzerdan to‘g‘ridan-to‘g‘ri so‘rov (agar kerak bo‘lsa); vergul bilan bir nechta origin
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# SWAGGER_ENABLED=true   # ishlab chiqarishda API hujjatlari (/hujjatlar) ni yoqish
# SWAGGER_ENABLED=false  # rivojlantirishda /hujjatlar ni o‘chirish
